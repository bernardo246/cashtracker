{
  "name": "@cash/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "pnpm --filter @cash/shared build",
    "dev": "tsx watch src/dev.ts",
    "prebuild": "pnpm --filter @cash/shared build",
    "build": "tsc -p tsconfig.build.json",
    "postbuild": "node scripts/copy-migrations.mjs",
    "pretypecheck": "pnpm --filter @cash/shared build",
    "typecheck": "tsc --noEmit -p .",
    "prelint": "pnpm --filter @cash/shared build",
    "lint": "eslint .",
    "pretest": "pnpm --filter @cash/shared build",
    "test": "vitest run",
    "start": "node dist/start.js",
    "keys:generate": "tsx scripts/generate-keys.ts"
  },
  "dependencies": {
    "@cash/shared": "workspace:*",
    "@fastify/cookie": "11.1.3",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.2.1",
    "argon2": "0.45.1",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.7",
    "jose": "6.2.12",
    "postgres": "3.4.9",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "tsx": "4.23.15",
    "vitest": "5.0.4"
  }
}
