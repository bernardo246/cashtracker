# Cash Tracker API — exemplo de variáveis de ambiente (valores fictícios).
# Copie para .env (ignorado pelo git) em desenvolvimento; em produção (Render) cadastre no painel.

# development | test | production
NODE_ENV=development
# Porta HTTP (o Render injeta PORT automaticamente)
PORT=4000
# URL pública do front-end (usada em CORS/redirects e links de e-mail)
APP_URL=http://localhost:3000

# Postgres. Em produção use a URI do Supabase "Session pooler" com ?sslmode=require, ex.:
# postgres://postgres.xxxx:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=postgres://cash:cash@localhost:5432/cash

# Chave privada JWT (PEM em base64) e seu id. Gere com: pnpm --filter @cash/api keys:generate
JWT_PRIVATE_KEY=BASE64_DO_PEM_AQUI
JWT_KEY_ID=chave-1
# Segredo dos cookies assinados (mínimo 32 caracteres)
COOKIE_SECRET=troque-por-um-segredo-aleatorio-com-32-ou-mais-caracteres

# Google OAuth (veja docs/setup-google-oauth.md)
GOOGLE_CLIENT_ID=0000000000-exemplo.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=exemplo-segredo-google
# O navegador chega à API pelo proxy do Next (porta 3000)
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# E-mail: brevo | console (console só imprime no log; use em desenvolvimento)
EMAIL_PROVIDER=console
# Obrigatórios apenas com EMAIL_PROVIDER=brevo
BREVO_API_KEY=xkeysib-exemplo
EMAIL_FROM=no-reply@example.com
EMAIL_FROM_NAME=Cash Tracker

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Limite de requisições; desative (false) só em testes/E2E
RATE_LIMIT_ENABLED=true
# Saltos de proxy confiáveis para descobrir o IP real.
# Desenvolvimento: 1. PRODUÇÃO: 2 (edge da Vercel + load balancer do Render).
TRUST_PROXY_HOPS=1
